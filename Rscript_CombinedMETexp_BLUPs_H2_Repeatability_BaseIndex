####################################################################
## Multi-environment alpha-lattice mixed model analysis
## Dataset: ComBLUPSdata
## Factors (as named in your data): GENOTYPE, ENV, REP, BLOCK
## Traits (as named in your data): POLLEN, SILK, ASI, PLHT, EHT, STYG,
##   PASP, HUSKC, RLPERC, SLPERC, EPP, EASP, EROT, YIELD
## Goal: genotypic BLUPs (across environments) for all 14 traits
####################################################################

## ---- 0. Packages ---------------------------------------------------
# Run install.packages() lines ONCE only if not already installed —
# no need to reinstall every session, only re-library() them.
# install.packages(c("tidyverse","lme4","lmerTest","sommer","broom.mixed","emmeans","clipr"))

library(tidyverse)
library(lme4)
library(lmerTest)
library(sommer)
library(broom.mixed)
library(emmeans)
library(clipr)

## ---- 1. Import and prepare data ------------------------------------

ComBLUPSdata <- clipr::read_clip_tbl()   # or: read_csv("your_file.csv")

str(ComBLUPSdata)   # confirm columns look right before proceeding

stopifnot(all(c("GENOTYPE","ENV","REP","BLOCK") %in% colnames(ComBLUPSdata)))

ComBLUPSdata <- ComBLUPSdata %>%
  mutate(
    ENV      = factor(ENV),
    REP      = factor(paste(ENV, REP, sep = "_")),           # REP unique within ENV
    BLOCK    = factor(paste(ENV, REP, BLOCK, sep = "_")),    # BLOCK unique within REP(ENV)
    GENOTYPE = factor(GENOTYPE)
  )

trait_names <- c("POLLEN", "SILK", "ASI", "PLHT", "EHT", "STYG", "PASP", "HUSKC",
                  "RLPERC", "SLPERC", "EPP", "EASP", "EROT", "YIELD")

####################################################################
## APPROACH A: lme4 — combined (multi-environment) alpha-lattice model
####################################################################
## Model per trait, across all environments simultaneously:
##   y = mu + ENV + (1|REP) + (1|BLOCK) + (1|GENOTYPE) + (1|GENOTYPE:ENV)
##
## Design choices:
##  - ENV fixed (few levels; usually too few to estimate a variance
##    component reliably as random)
##  - REP within ENV: random (as intended by design)
##  - Incomplete BLOCK within REP within ENV: random (recovers
##    inter-block information)
##  - GENOTYPE: random -> gives shrunken BLUPs
##  - GENOTYPE:ENV: random -> captures GxE, needed for stable
##    across-environment BLUPs

fit_lmer_one_trait <- function(trait, data) {
  f <- as.formula(
    paste0(trait, " ~ ENV + (1|REP) + (1|BLOCK) + (1|GENOTYPE) + (1|GENOTYPE:ENV)")
  )
  lmer(f, data = data, REML = TRUE,
       control = lmerControl(optimizer = "bobyqa",
                              optCtrl = list(maxfun = 2e5)))
}

lmer_fits <- map(trait_names, ~ fit_lmer_one_trait(.x, ComBLUPSdata)) %>%
  set_names(trait_names)

# Convergence check — inspect before trusting any downstream results
convergence_check <- tibble(
  Trait = trait_names,
  singular = map_lgl(lmer_fits, isSingular),
  messages = map_chr(lmer_fits, ~ paste(.x@optinfo$conv$lme4$messages, collapse = "; "))
)
print(convergence_check)

####################################################################
## Extract genotype BLUPs (across-environment genotypic performance)
####################################################################

get_genotype_blups <- function(model, trait) {
  intercept <- fixef(model)[["(Intercept)"]]
  # mean ENV fixed-effect contribution, so BLUPs represent an
  # across-environment genotype mean rather than the reference ENV level
  env_fx <- fixef(model)[grepl("^ENV", names(fixef(model)))]
  env_mean_adj <- mean(c(0, env_fx))

  re <- ranef(model, condVar = TRUE)$GENOTYPE
  pv <- attr(re, "postVar")
  se <- sqrt(pv[1, 1, ])

  tibble(
    Genotype = rownames(re),
    Trait = trait,
    BLUP_deviation = re[, 1],
    BLUP_value = intercept + env_mean_adj + re[, 1],
    SE = se
  )
}

genotype_blups_all <- map2_dfr(lmer_fits, trait_names, get_genotype_blups)

genotype_blups_wide <- genotype_blups_all %>%
  dplyr::select(Genotype, Trait, BLUP_value) %>%
  pivot_wider(names_from = Trait, values_from = BLUP_value)

write_csv(genotype_blups_wide, "genotype_BLUPs_wide.csv")
write_csv(genotype_blups_all,  "genotype_BLUPs_long.csv")

####################################################################
## Variance components + broad-sense heritability (per trait)
####################################################################
## H2 (across-environment, entry-mean basis):
##   H2 = Vg / (Vg + Vge/n_env + Ve/(n_env * n_rep))

n_env <- nlevels(ComBLUPSdata$ENV)
n_rep <- 2   # reps per environment — edit if this differs

get_varcomp_h2 <- function(model, trait) {
  vc <- as.data.frame(VarCorr(model))
  Vg     <- vc$vcov[vc$grp == "GENOTYPE"]
  Vge    <- vc$vcov[vc$grp == "GENOTYPE:ENV"]
  Ve     <- attr(VarCorr(model), "sc")^2
  Vrep   <- vc$vcov[vc$grp == "REP"]
  Vblock <- vc$vcov[vc$grp == "BLOCK"]

  H2 <- Vg / (Vg + Vge / n_env + Ve / (n_env * n_rep))

  tibble(Trait = trait, Vg = Vg, Vge = Vge, Vrep = Vrep,
         Vblock = Vblock, Ve = Ve, H2_broad_sense = H2)
}

varcomp_summary <- map2_dfr(lmer_fits, trait_names, get_varcomp_h2)
write_csv(varcomp_summary, "variance_components_H2.csv")
print(varcomp_summary)

####################################################################
## APPROACH B: sommer — same model, often more stable for unbalanced
## alpha-lattice designs and gives heritability directly
####################################################################

fit_sommer_one_trait <- function(trait, data) {
  data$y <- data[[trait]]
  mmer(
    y ~ ENV,
    random = ~ REP + BLOCK + GENOTYPE + GENOTYPE:ENV,
    rcov   = ~ units,
    data   = data,
    verbose = FALSE
  )
}

sommer_fits <- map(trait_names, ~ fit_sommer_one_trait(.x, ComBLUPSdata)) %>%
  set_names(trait_names)

get_sommer_blups <- function(model, trait) {
  u <- model$U$GENOTYPE$y
  tibble(Genotype = names(u), Trait = trait, BLUP_deviation = as.numeric(u))
}

sommer_blups_all <- map2_dfr(sommer_fits, trait_names, get_sommer_blups)

get_sommer_h2_safe <- function(model, trait, n_env, n_rep) {
  vc <- summary(model)$varcomp
  Vg  <- vc["GENOTYPE",     "VarComp"]
  Vge <- vc["GENOTYPE:ENV", "VarComp"]
  Ve  <- vc["units",        "VarComp"]
  H2 <- Vg / (Vg + Vge / n_env + Ve / (n_env * n_rep))
  tibble(Trait = trait, Vg = Vg, Vge = Vge, Ve = Ve, H2 = H2)
}

sommer_h2_summary <- map2_dfr(sommer_fits, trait_names,
                               ~ get_sommer_h2_safe(.x, .y, n_env, n_rep))
write_csv(sommer_h2_summary, "sommer_H2_summary.csv")

####################################################################
## Optional: single-environment (within-year) BLUPs, if also needed
####################################################################

fit_within_env <- function(trait, env_level, data) {
  d <- filter(data, ENV == env_level)
  f <- as.formula(paste0(trait, " ~ (1|REP) + (1|BLOCK) + (1|GENOTYPE)"))
  lmer(f, data = d, REML = TRUE)
}

within_env_blups <- expand_grid(Trait = trait_names, ENV = levels(ComBLUPSdata$ENV)) %>%
  pmap_dfr(function(Trait, ENV) {
    m  <- fit_within_env(Trait, ENV, ComBLUPSdata)
    re <- ranef(m)$GENOTYPE
    tibble(Genotype = rownames(re), Env = ENV, Trait = Trait,
           BLUP_value = fixef(m)[["(Intercept)"]] + re[, 1])
  })

write_csv(within_env_blups, "within_environment_BLUPs.csv")

####################################################################
## Notes
####################################################################
# 1. Convergence: check convergence_check (built above) before
#    trusting results. isSingular() flags variance components (often
#    BLOCK or REP) estimated at ~0 — common in smaller alpha-lattice
#    designs, not necessarily an error.
#
# 2. If BLOCK variance is ~0 for a trait, blocking added little
#    information there — BLUPs are still valid; compare against a
#    simpler model without BLOCK via anova()/AIC if you want to check.
#
# 3. GENOTYPE:ENV as random assumes genotype BLUPs should be shrunk
#    toward the across-environment mean under a common GxE variance.
#    For environment-specific predictions instead, use
#    within_env_blups above, or ranef(model)$`GENOTYPE:ENV` from the
#    combined model.
#
# 4. For very unbalanced/small blocks, sommer or ASReml-R generally
#    handle alpha-lattice structure more robustly than lme4 — compare
#    genotype_blups_all against sommer_blups_all as a cross-check.
#
# 5. All select() calls use dplyr:: explicitly, since MASS (loaded as
#    a dependency of lme4/sommer) defines its own select() that would
#    otherwise silently override dplyr's and cause an "unused
#    arguments" error.
